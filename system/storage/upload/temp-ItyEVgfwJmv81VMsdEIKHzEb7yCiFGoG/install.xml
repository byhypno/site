<?xml version="1.0" encoding="utf-8"?>
<modification>
  <name>Egeser V21.1 Floorplan Frontend Integration Fix</name>
  <code>egeser_v21_1_floorplan_frontend_fix</code>
  <version>21.1.0</version>
  <author>EGESER</author>
  <link>https://egeserprefabrik.com.tr</link>

  <file path="catalog/controller/product/product.php">
    <operation error="skip">
      <search><![CDATA[$this->response->setOutput($this->load->view('product/product', $data));]]></search>
      <add position="before"><![CDATA[
        /* EGESER V21.1 - Kat planlarini urun galerisinden tamamen ayir. */
        $data['egeser_floorplans_v211'] = array();
        if (isset($product_id)) {
            $this->load->model('extension/module/egeser_floorplan');
            $this->load->model('tool/image');
            $eg_v211_rows = $this->model_extension_module_egeser_floorplan->getPlans((int)$product_id);
            foreach ($eg_v211_rows as $eg_v211_row) {
                if (empty($eg_v211_row['image']) || !is_file(DIR_IMAGE . $eg_v211_row['image'])) {
                    continue;
                }
                $eg_v211_title = trim($eg_v211_row['title']);
                if ($eg_v211_title === '') {
                    $eg_v211_title = 'Kat Planı';
                }
                $data['egeser_floorplans_v211'][] = array(
                    'title' => $eg_v211_title,
                    'image' => $this->model_tool_image->resize($eg_v211_row['image'], 1400, 1050),
                    'popup' => $this->model_tool_image->resize($eg_v211_row['image'], 2200, 1650)
                );
            }
        }
      ]]></add>
    </operation>
  </file>

  <file path="catalog/view/theme/egeser/template/product/product.tpl">
    <operation error="skip">
      <search><![CDATA[        <div class="eg11-plan-media">
          <?php if (!empty($eg_plan_image['popup'])) { ?>
            <img src="<?php echo $eg_plan_image['popup']; ?>" alt="<?php echo htmlspecialchars(strip_tags($heading_title), ENT_QUOTES, 'UTF-8'); ?> kat planı" loading="lazy" decoding="async">
          <?php } else { ?>
            <div class="eg11-plan-placeholder">
              <div>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16v16H4zM4 11h7V4M11 20v-5h9M11 11h9"></path></svg>
                <strong>Kat planı görseli hazırlanıyor</strong>
                <span>Plan bilgileri model özellikleriyle birlikte aşağıda yer alır.</span>
              </div>
            </div>
          <?php } ?>
        </div>]]></search>
      <add position="replace"><![CDATA[        <div class="eg11-plan-media eg-v211-plan-media" id="eg-v211-floorplans">
          <?php if (!empty($egeser_floorplans_v211)) { ?>
            <?php if (count($egeser_floorplans_v211) > 1) { ?>
              <div class="eg-v211-tabs" role="tablist" aria-label="Kat planları">
                <?php foreach ($egeser_floorplans_v211 as $eg_v211_i => $eg_v211_plan) { ?>
                  <button type="button" class="eg-v211-tab<?php echo $eg_v211_i === 0 ? ' is-active' : ''; ?>" data-eg-v211-tab="<?php echo (int)$eg_v211_i; ?>" role="tab" aria-selected="<?php echo $eg_v211_i === 0 ? 'true' : 'false'; ?>">
                    <?php echo htmlspecialchars($eg_v211_plan['title'], ENT_QUOTES, 'UTF-8'); ?>
                  </button>
                <?php } ?>
              </div>
            <?php } ?>

            <div class="eg-v211-stage">
              <?php foreach ($egeser_floorplans_v211 as $eg_v211_i => $eg_v211_plan) { ?>
                <figure class="eg-v211-panel<?php echo $eg_v211_i === 0 ? ' is-active' : ''; ?>" data-eg-v211-panel="<?php echo (int)$eg_v211_i; ?>"<?php echo $eg_v211_i === 0 ? '' : ' hidden'; ?>>
                  <a class="eg-v211-image-link" href="<?php echo $eg_v211_plan['popup']; ?>" target="_blank" rel="noopener" aria-label="<?php echo htmlspecialchars($eg_v211_plan['title'], ENT_QUOTES, 'UTF-8'); ?> planını büyüt">
                    <img src="<?php echo $eg_v211_plan['image']; ?>" alt="<?php echo htmlspecialchars(strip_tags($heading_title) . ' - ' . $eg_v211_plan['title'], ENT_QUOTES, 'UTF-8'); ?>" loading="lazy" decoding="async">
                  </a>
                  <figcaption>
                    <strong><?php echo htmlspecialchars($eg_v211_plan['title'], ENT_QUOTES, 'UTF-8'); ?></strong>
                    <span>Planı büyütmek için görsele tıklayın.</span>
                  </figcaption>
                </figure>
              <?php } ?>
            </div>
          <?php } else { ?>
            <div class="eg11-plan-placeholder eg-v211-empty">
              <div>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16v16H4zM4 11h7V4M11 20v-5h9M11 11h9"></path></svg>
                <strong>Kat planı henüz eklenmedi</strong>
                <span>Bu ürün için kat planı Egeser Kat Planı Yöneticisi'nden eklenebilir.</span>
              </div>
            </div>
          <?php } ?>
        </div>

        <style id="eg-v211-floorplan-style">
          /* V21.0'in ayrica bastigi blok varsa gizle; tek resmi kaynak V11 Kat Plani alani olsun. */
          .eg-floorplans-v21{display:none!important}
          .eg-v211-plan-media{position:relative;min-width:0}
          .eg-v211-tabs{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 14px}
          .eg-v211-tab{appearance:none;border:1px solid #e8ded4;background:#fff;color:#1d1d1d;border-radius:999px;padding:9px 15px;font:inherit;font-size:13px;font-weight:800;line-height:1.2;cursor:pointer;transition:.18s ease}
          .eg-v211-tab:hover{border-color:#f3a31b}
          .eg-v211-tab.is-active{background:#1a1a1a;border-color:#1a1a1a;color:#fff}
          .eg-v211-stage{position:relative;min-width:0}
          .eg-v211-panel{margin:0;min-width:0}
          .eg-v211-panel[hidden]{display:none!important}
          .eg-v211-image-link{display:flex;align-items:center;justify-content:center;width:100%;min-height:420px;overflow:hidden;border:1px solid #eee3d8;border-radius:18px;background:#faf7f2;text-decoration:none}
          .eg-v211-panel img{display:block;width:100%;height:auto;max-height:720px;object-fit:contain;margin:auto;background:#fff}
          .eg-v211-panel figcaption{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:12px 3px 0;color:#6c6c6c;font-size:13px}
          .eg-v211-panel figcaption strong{color:#1a1a1a;font-size:14px}
          .eg-v211-empty{min-height:420px}
          @media(max-width:767px){
            .eg-v211-tabs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}
            .eg-v211-tab{width:100%;padding:9px 8px;font-size:12px}
            .eg-v211-image-link{min-height:260px;border-radius:14px}
            .eg-v211-panel img{max-height:520px}
            .eg-v211-panel figcaption{display:block;padding-top:9px}
            .eg-v211-panel figcaption span{display:block;margin-top:3px}
            .eg-v211-empty{min-height:260px}
          }
        </style>
        <script>
        (function(){
          function initEgV211(){
            var root=document.getElementById('eg-v211-floorplans');
            if(!root || root.getAttribute('data-eg-v211-ready')==='1') return;
            root.setAttribute('data-eg-v211-ready','1');
            var tabs=root.querySelectorAll('[data-eg-v211-tab]');
            var panels=root.querySelectorAll('[data-eg-v211-panel]');
            for(var i=0;i<tabs.length;i++){
              tabs[i].addEventListener('click',function(){
                var key=this.getAttribute('data-eg-v211-tab');
                for(var t=0;t<tabs.length;t++){
                  var on=tabs[t]===this;
                  tabs[t].classList.toggle('is-active',on);
                  tabs[t].setAttribute('aria-selected',on?'true':'false');
                }
                for(var p=0;p<panels.length;p++){
                  var show=panels[p].getAttribute('data-eg-v211-panel')===key;
                  panels[p].classList.toggle('is-active',show);
                  if(show){panels[p].removeAttribute('hidden');}else{panels[p].setAttribute('hidden','hidden');}
                }
              });
            }
          }
          if(document.readyState==='loading'){
            document.addEventListener('DOMContentLoaded',initEgV211);
          }else{
            initEgV211();
          }
        })();
        </script>]]></add>
    </operation>
  </file>
</modification>
